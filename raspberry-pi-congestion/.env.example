RUN_MODE={setup-roi|dry-run|file|rtsp|test}
SAFEROUTE_SERVER_BASE_URL={SERVER_BASE_URL}
CONGESTION_OBSERVATION_PATH={API_PATH}
CCTV_CODE={CCTV_CODE}
DEVICE_AUTH_TOKEN={DEVICE_AUTH_TOKEN}
AUTH_HEADER_NAME={AUTH_HEADER_NAME}
AUTH_HEADER_PREFIX={AUTH_HEADER_PREFIX}
VIDEO_SOURCE={VIDEO_FILE_OR_RTSP_URL}
VIDEO_LOOP=false
ROI_CONFIG_PATH=./config/roi/{CCTV_CODE}.json
DETECTOR_BACKEND={ultralytics|onnx|hailo|fake}
MODEL_PATH=./models/{MODEL_FILE}
DETECTOR_CONF_THRESHOLD=0.4
TARGET_INFERENCE_FPS=5
WINDOW_SEC=5
REQUEST_TIMEOUT_SEC=5
MAX_HTTP_RETRIES=2
RTSP_MAX_RECONNECTS=5
RTSP_RECONNECT_BASE_DELAY_SEC=1
OFFLINE_QUEUE_DB_PATH={SQLITE_PATH}
OFFLINE_QUEUE_MAX_AGE_SEC=86400
OFFLINE_QUEUE_MAX_ITEMS=1000
OFFLINE_FLUSH_INTERVAL_SEC=30
LOG_LEVEL=INFO
